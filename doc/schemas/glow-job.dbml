Project glow_job {
  database_type: 'PostgreSQL'
  Note: 'Canonical whole-system schema draft based on doc/glow_job_database_schema.md. DBML only: it does not create or migrate a database. MVP implementation starts with core reference data and market ingestion; other domains are planned.'
}

// Shared vocabularies from the product schema document.
Enum requirement_type {
  required
  preferred
  optional
  unknown
}

Enum proficiency_level {
  beginner
  intermediate
  advanced
  expert
  unknown
}

Enum importance_tier {
  core
  important
  optional
  unknown
}

Enum dependency_type {
  prerequisite
  recommended_before
  related
}

Enum dependency_strength {
  required
  strong
  recommended
  weak
}

Enum user_skill_source {
  resume
  self_report
  assessment
  project
  application_feedback
  system_inferred
}

Enum verification_type {
  self_report
  assessment
  project_evidence
  real_world_outcome
  unverified
}

Enum roadmap_status {
  active
  completed
  replaced
  archived
}

Enum progress_status {
  not_started
  in_progress
  completed
  skipped
}

Enum ingestion_status {
  pending
  running
  completed
  failed
}

Enum experience_type {
  work
  internship
  project
  education
  competition
  course
  other
}

Enum application_status {
  applied
  interview
  rejected
  offer
}

// CORE: canonical entities shared by the market pipeline and product app.
Table core.companies {
  company_id bigint [pk, increment]
  company_name text [not null]
  normalized_name text
  company_website text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    normalized_name [name: 'ix_companies_normalized_name']
  }
}

Table core.careers {
  career_id bigint [pk, increment]
  slug text [not null, unique, note: 'Stable key, for example data_engineer']
  career_name text [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table core.career_profiles {
  career_profile_id bigint [pk, increment]
  career_id bigint [not null]
  slug text [not null, unique, note: 'Career plus seniority, for example junior_data_engineer']
  profile_name text [not null]
  seniority_level text [not null, note: 'Examples: junior, mid, senior, general']
  description text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    career_id [name: 'ix_career_profiles_career_id']
  }
}

Table core.skills {
  skill_id bigint [pk, increment]
  skill_name text [not null, unique]
  skill_category text
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table core.skill_aliases {
  alias_id bigint [pk, increment]
  skill_id bigint [not null]
  alias text [not null, unique]
  created_at timestamptz [not null, default: `now()`]
}

// MARKET: JSearch postings first, followed later by skill extraction and aggregates.
Table market.job_postings {
  job_id bigint [pk, increment]
  provider_job_id text [note: 'Provider job identifier; may be null when unavailable']
  company_id bigint
  career_profile_id bigint [not null]
  job_title text [not null]
  normalized_job_title text
  job_description text
  location text
  city text
  state text
  country char(2)
  employment_type text
  provider text [not null, default: 'jsearch']
  publisher text [note: 'Publisher reported by the provider, distinct from provider']
  source_url text
  posted_at timestamptz
  collected_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_job_id) [unique, name: 'uq_job_postings_provider_job']
    career_profile_id [name: 'ix_job_postings_career_profile_id']
    company_id [name: 'ix_job_postings_company_id']
    posted_at [name: 'ix_job_postings_posted_at']
  }
}

Table market.job_search_matches {
  job_id bigint [not null]
  run_id bigint [not null]
  career_profile_id bigint [not null]
  search_query text [not null]
  collected_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, run_id, search_query) [pk]
    run_id [name: 'ix_job_search_matches_run_id']
  }

  Note: 'Preserves which search queries returned a deduplicated posting; one job can match multiple queries or runs.'
}

Table market.job_skills {
  job_id bigint [not null]
  skill_id bigint [not null]
  requirement_type requirement_type [not null, default: 'unknown']
  proficiency_level proficiency_level
  importance_weight numeric(4, 3)
  confidence numeric(4, 3)
  evidence_text text
  extraction_method text [note: 'Examples: llm, rule, hybrid']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (job_id, skill_id) [pk]
  }
}

Table market.career_skill_stats {
  career_profile_id bigint [not null]
  skill_id bigint [not null]
  analysis_start_date date [not null]
  analysis_end_date date [not null]
  demand_count integer [not null]
  total_jobs integer [not null]
  demand_percentage numeric(5, 2) [not null]
  required_count integer [not null, default: 0]
  preferred_count integer [not null, default: 0]
  optional_count integer [not null, default: 0]
  weighted_demand_score numeric(8, 4)
  target_level proficiency_level
  target_level_confidence numeric(4, 3)
  level_observation_count integer [not null, default: 0]
  importance_tier importance_tier [not null, default: 'unknown']
  last_updated timestamptz [not null, default: `now()`]

  indexes {
    (career_profile_id, skill_id, analysis_start_date, analysis_end_date) [pk]
  }
}

// KNOWLEDGE: content metadata, chunks and skill relationships for later RAG work.
Table knowledge.knowledge_sources {
  source_id bigint [pk, increment]
  skill_id bigint
  source_type text [not null, note: 'Examples: official_docs, course, article, learning_path']
  title text [not null]
  source_url text
  storage_key text [note: 'Object key for the original document in S3']
  publisher text
  is_active boolean [not null, default: true]
  collected_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table knowledge.knowledge_chunks {
  chunk_id bigint [pk, increment]
  source_id bigint [not null]
  skill_id bigint
  topic text
  chunk_index integer [not null]
  content text [not null]
  metadata jsonb
  embedding_model text
  embedding vector [note: 'Requires a PostgreSQL vector extension if stored in PostgreSQL']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (source_id, chunk_index) [unique, name: 'uq_knowledge_chunks_source_index']
  }
}

Table knowledge.skill_dependencies {
  dependency_id bigint [pk, increment]
  prerequisite_skill_id bigint [not null]
  target_skill_id bigint [not null]
  dependency_type dependency_type [not null]
  strength dependency_strength [not null]
  confidence numeric(4, 3)
  source_id bigint
  evidence_text text
  is_verified boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (prerequisite_skill_id, target_skill_id, dependency_type) [unique, name: 'uq_skill_dependencies_edge']
  }
}

Table knowledge.learning_modules {
  module_id bigint [pk, increment]
  skill_id bigint [not null]
  level proficiency_level [not null]
  title text [not null]
  description text
  learning_outcome text
  sequence_order integer [not null]
  estimated_hours numeric(6, 2)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// APP: user-owned data and learning plans; planned until product implementation.
Table app.users {
  user_id bigint [pk, increment]
  email text [not null, unique]
  auth_provider text [not null]
  auth_subject text [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (auth_provider, auth_subject) [unique, name: 'uq_users_auth_identity']
  }
}

Table app.user_profiles {
  user_id bigint [pk]
  target_career_profile_id bigint
  current_status text
  education_level text
  field_of_study text
  current_role text
  experience_years numeric(5, 2)
  target_duration_months integer
  available_hours_per_week numeric(5, 2)
  preferred_learning_style text
  background_text text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app.resumes {
  resume_id bigint [pk, increment]
  user_id bigint [not null]
  file_name text [not null]
  storage_key text [not null, note: 'Resume file is stored in S3']
  extraction_status text [not null, default: 'pending']
  extracted_text text
  uploaded_at timestamptz [not null, default: `now()`]
  processed_at timestamptz
}

Table app.user_experiences {
  experience_id bigint [pk, increment]
  user_id bigint [not null]
  experience_type experience_type [not null]
  title text [not null]
  organization text
  description text
  start_date date
  end_date date
  source text [note: 'Examples: resume, self_report']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app.user_skills {
  user_id bigint [not null]
  skill_id bigint [not null]
  proficiency_level proficiency_level [not null, default: 'unknown']
  source user_skill_source [not null]
  confidence numeric(4, 3)
  verification_type verification_type [not null, default: 'unverified']
  evidence_reference text
  verified_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, skill_id) [pk]
  }
}

Table app.roadmaps {
  roadmap_id bigint [pk, increment]
  user_id bigint [not null]
  target_career_profile_id bigint [not null]
  version integer [not null]
  status roadmap_status [not null, default: 'active']
  generation_reason text
  market_analysis_start_date date
  market_analysis_end_date date
  generated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, version) [unique, name: 'uq_roadmaps_user_version']
  }
}

Table app.roadmap_items {
  roadmap_item_id bigint [pk, increment]
  roadmap_id bigint [not null]
  skill_id bigint
  module_id bigint
  sequence_order integer [not null]
  title text [not null]
  target_level proficiency_level
  reason text
  estimated_hours numeric(6, 2)
  is_required boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table app.roadmap_tasks {
  task_id bigint [pk, increment]
  roadmap_item_id bigint [not null]
  title text [not null]
  description text
  sequence_order integer [not null]
  is_required boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table app.user_progress {
  progress_id bigint [pk, increment]
  user_id bigint [not null]
  roadmap_item_id bigint [not null]
  status progress_status [not null, default: 'not_started']
  progress_percentage numeric(5, 2) [not null, default: 0]
  user_note text
  started_at timestamptz
  completed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, roadmap_item_id) [unique, name: 'uq_user_progress_item']
  }
}

Table app.user_task_progress {
  user_id bigint [not null]
  task_id bigint [not null]
  status progress_status [not null, default: 'not_started']
  completed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, task_id) [pk]
  }
}

// Phase 2 product scope from the schema document.
Table app.applications {
  application_id bigint [pk, increment]
  user_id bigint [not null]
  job_id bigint
  company_id bigint
  job_title text [not null]
  status application_status [not null]
  applied_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table app.application_feedback {
  feedback_id bigint [pk, increment]
  application_id bigint [not null]
  feedback_type text [not null]
  feedback_text text
  extracted_reason text
  created_at timestamptz [not null, default: `now()`]
}

// SYSTEM: operational records shared by ingestion and future AI workflows.
Table system.ingestion_runs {
  run_id bigint [pk, increment]
  run_key text [unique, note: 'Optional external pipeline run identifier; keep separate from the DB primary key']
  source text [not null]
  career_profile_id bigint
  raw_storage_key text [note: 'Optional S3 key for the raw response/run artifact']
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
  jobs_fetched integer [not null, default: 0]
  jobs_inserted integer [not null, default: 0]
  jobs_updated integer [not null, default: 0]
  jobs_failed integer [not null, default: 0]
  status ingestion_status [not null, default: 'pending']
  error_message text
  created_at timestamptz [not null, default: `now()`]
}

Table system.ai_runs {
  ai_run_id bigint [pk, increment]
  user_id bigint
  operation_type text [not null]
  model_provider text
  model_name text
  status text [not null]
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
  error_message text
}

// Cross-domain relationships. PostgreSQL schemas live in one database, so these
// foreign keys can be enforced without splitting the domains into separate DBs.
Ref: core.career_profiles.career_id > core.careers.career_id
Ref: core.skill_aliases.skill_id > core.skills.skill_id

Ref: market.job_postings.company_id > core.companies.company_id
Ref: market.job_postings.career_profile_id > core.career_profiles.career_profile_id
Ref: market.job_search_matches.job_id > market.job_postings.job_id
Ref: market.job_search_matches.run_id > system.ingestion_runs.run_id
Ref: market.job_search_matches.career_profile_id > core.career_profiles.career_profile_id
Ref: market.job_skills.job_id > market.job_postings.job_id
Ref: market.job_skills.skill_id > core.skills.skill_id
Ref: market.career_skill_stats.career_profile_id > core.career_profiles.career_profile_id
Ref: market.career_skill_stats.skill_id > core.skills.skill_id

Ref: knowledge.knowledge_sources.skill_id > core.skills.skill_id
Ref: knowledge.knowledge_chunks.source_id > knowledge.knowledge_sources.source_id
Ref: knowledge.knowledge_chunks.skill_id > core.skills.skill_id
Ref: knowledge.skill_dependencies.prerequisite_skill_id > core.skills.skill_id
Ref: knowledge.skill_dependencies.target_skill_id > core.skills.skill_id
Ref: knowledge.skill_dependencies.source_id > knowledge.knowledge_sources.source_id
Ref: knowledge.learning_modules.skill_id > core.skills.skill_id

Ref: app.users.user_id - app.user_profiles.user_id
Ref: app.user_profiles.target_career_profile_id > core.career_profiles.career_profile_id
Ref: app.resumes.user_id > app.users.user_id
Ref: app.user_experiences.user_id > app.users.user_id
Ref: app.user_skills.user_id > app.users.user_id
Ref: app.user_skills.skill_id > core.skills.skill_id
Ref: app.roadmaps.user_id > app.users.user_id
Ref: app.roadmaps.target_career_profile_id > core.career_profiles.career_profile_id
Ref: app.roadmap_items.roadmap_id > app.roadmaps.roadmap_id
Ref: app.roadmap_items.skill_id > core.skills.skill_id
Ref: app.roadmap_items.module_id > knowledge.learning_modules.module_id
Ref: app.roadmap_tasks.roadmap_item_id > app.roadmap_items.roadmap_item_id
Ref: app.user_progress.user_id > app.users.user_id
Ref: app.user_progress.roadmap_item_id > app.roadmap_items.roadmap_item_id
Ref: app.user_task_progress.user_id > app.users.user_id
Ref: app.user_task_progress.task_id > app.roadmap_tasks.task_id
Ref: app.applications.user_id > app.users.user_id
Ref: app.applications.job_id > market.job_postings.job_id
Ref: app.applications.company_id > core.companies.company_id
Ref: app.application_feedback.application_id > app.applications.application_id

Ref: system.ingestion_runs.career_profile_id > core.career_profiles.career_profile_id
Ref: system.ai_runs.user_id > app.users.user_id
