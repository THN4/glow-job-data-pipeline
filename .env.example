# Used by data-pipeline scripts run directly on Windows (not the root Backend container).
JSEARCH_API_KEY=
# RDS over the Windows SSH tunnel. Keep the tunnel listening on 127.0.0.1:15432.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=glowjob
DB_USER=dev_champ
DB_PASSWORD=replace-with-rds-app-password
# Keep the normal application role here. For schema migrations, use the RDS
# migration/admin role temporarily in the current CMD session; do not save it here.
LLM_API_KEY=
LOG_LEVEL=INFO
GEMINI_API_KEY=
# Resume CV extraction uses the same Gemini API key and pinned model as market.
RESUME_EXTRACTOR=mock
RESUME_GEMINI_TIMEOUT_MS=180000
