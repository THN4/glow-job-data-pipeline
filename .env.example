# Used by data-pipeline scripts run directly on Windows (not the root Backend container).
JSEARCH_API_KEY=
# On EC2, prefer a plaintext Secrets Manager SecretString and set its name/ARN here.
JSEARCH_SECRET_ID=
# Leave blank to save raw JSearch responses locally. Set to an S3 bucket name
# to also upload each response under RAW_S3_PREFIX/YYYY/MM/DD/<run_id>/.
# A local raw copy is retained for recovery. The scheduled runner defaults to S3;
# use --raw-storage local explicitly for local-only execution.
RAW_S3_BUCKET=
RAW_S3_PREFIX=raw/jsearch
# The scheduled runner saves state/checkpoints under market/pipeline-runs/<run_id>/.
AWS_DEFAULT_REGION=us-east-1
# RDS over the Windows SSH tunnel. Keep the tunnel listening on 127.0.0.1:15432.
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=glowjob
DB_USER=dev_champ
DB_PASSWORD=replace-with-rds-app-password
# Keep the normal application role here. For schema migrations, use the RDS
# migration/admin role temporarily in the current CMD session; do not save it here.
LLM_API_KEY=
LOG_LEVEL=INFO
GEMINI_API_KEY=
# Resume CV extraction uses the same Gemini API key and pinned model as market.
RESUME_EXTRACTOR=mock
RESUME_GEMINI_TIMEOUT_MS=180000
