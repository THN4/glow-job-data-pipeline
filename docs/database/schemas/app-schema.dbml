Project glow_job_app {
  database_type: 'PostgreSQL'
  Note: 'Conceptual application-side schema. Career, skill, and job identifiers are owned by the separate data-pipeline service; no cross-database foreign keys are assumed.'
}

Enum user_skill_level {
  beginner
  intermediate
  advanced
  expert
}

Enum roadmap_status {
  draft
  active
  completed
  archived
}

Enum roadmap_step_status {
  not_started
  in_progress
  completed
  skipped
}

Enum application_status {
  interested
  applied
  interviewing
  offered
  rejected
  withdrawn
}

Enum interview_session_status {
  in_progress
  completed
  abandoned
}

Table users {
  user_id bigint [pk, increment]
  email text [not null, unique]
  password_hash text [not null, note: 'Store a password hash, never a plain-text password']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_profiles {
  user_id bigint [pk, not null]
  display_name text
  current_job_title text
  years_experience numeric(4, 1)
  location text
  education_level text
  updated_at timestamptz [not null, default: `now()`]
}

Table user_skills {
  user_id bigint [pk, not null]
  skill_id bigint [pk, not null, note: 'External ID from the pipeline skills data']
  proficiency_level user_skill_level
  years_experience numeric(4, 1)
  added_at timestamptz [not null, default: `now()`]
}

Table user_career_goals {
  user_id bigint [pk, not null]
  career_id bigint [pk, not null, note: 'External ID from pipeline career_roles']
  is_primary boolean [not null, default: false]
  target_date date
  created_at timestamptz [not null, default: `now()`]
}

Table roadmaps {
  roadmap_id bigint [pk, increment]
  user_id bigint [not null]
  career_id bigint [not null, note: 'External ID from pipeline career_roles']
  title text [not null]
  status roadmap_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, career_id, status) [name: 'ix_roadmaps_user_career_status']
  }
}

Table roadmap_steps {
  roadmap_step_id bigint [pk, increment]
  roadmap_id bigint [not null]
  step_number integer [not null]
  title text [not null]
  description text
  skill_id bigint [note: 'Optional external ID from pipeline skills data']
  status roadmap_step_status [not null, default: 'not_started']
  due_date date
  completed_at timestamptz

  indexes {
    (roadmap_id, step_number) [unique, name: 'uq_roadmap_steps_number']
  }
}

Table job_recommendations {
  recommendation_id bigint [pk, increment]
  user_id bigint [not null]
  job_id bigint [not null, note: 'External ID from pipeline job_postings']
  match_score numeric(5, 2) [not null, note: 'Expected range is 0 to 100']
  explanation text
  recommended_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, job_id) [unique, name: 'uq_job_recommendations_user_job']
  }
}

Table saved_jobs {
  user_id bigint [pk, not null]
  job_id bigint [pk, not null, note: 'External ID from pipeline job_postings']
  saved_at timestamptz [not null, default: `now()`]
}

Table job_applications {
  application_id bigint [pk, increment]
  user_id bigint [not null]
  job_id bigint [not null, note: 'External ID from pipeline job_postings']
  status application_status [not null, default: 'interested']
  applied_at timestamptz
  notes text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, job_id) [name: 'ix_job_applications_user_job']
  }
}

Table interview_sessions {
  interview_session_id bigint [pk, increment]
  user_id bigint [not null]
  job_id bigint [note: 'Optional external ID from pipeline job_postings']
  career_id bigint [note: 'Optional external ID from pipeline career_roles']
  status interview_session_status [not null, default: 'in_progress']
  started_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
}

Table interview_feedback {
  feedback_id bigint [pk, increment]
  interview_session_id bigint [not null]
  question text [not null]
  user_response text
  score numeric(5, 2) [note: 'Optional score; expected range is 0 to 100']
  feedback text
  created_at timestamptz [not null, default: `now()`]
}

Ref: user_profiles.user_id - users.user_id
Ref: user_skills.user_id > users.user_id
Ref: user_career_goals.user_id > users.user_id
Ref: roadmaps.user_id > users.user_id
Ref: roadmap_steps.roadmap_id > roadmaps.roadmap_id [delete: cascade]
Ref: job_recommendations.user_id > users.user_id
Ref: saved_jobs.user_id > users.user_id
Ref: job_applications.user_id > users.user_id
Ref: interview_sessions.user_id > users.user_id
Ref: interview_feedback.interview_session_id > interview_sessions.interview_session_id [delete: cascade]
